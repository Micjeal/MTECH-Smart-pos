      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Alerts centre",
      "short_name": "Alerts",
      "description": "Review operational risks and pending actions",
      "url": "/#/alerts",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Expenses",
      "short_name": "Expenses",
